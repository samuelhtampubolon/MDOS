# Copy to .env and fill in. Never commit .env (it is gitignored).

# ---- Mode -------------------------------------------------------------------------------------------
# local: desktop, single user, loopback only, SQLite in your user data folder
# cloud: accounts and JWT; use PostgreSQL and a strong SECRET_KEY
MDOS_MODE=cloud

# ---- Security (cloud) --------------------------------------------------------------------------------
# At least 32 random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Host names the server answers to, comma-separated. Add your domain, for example: mdos.example.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1
# Sign-up. Empty: only the first account may register (recommended). true: anyone who can reach the server
# can create a workspace (and use your Claude key). false: closed.
ALLOW_REGISTRATION=
# Addresses of your reverse proxy. Only these may set the client IP and https headers (rate limits, Secure cookies).
FORWARDED_ALLOW_IPS=127.0.0.1
# Empty: the session cookie is Secure when the request arrived over https. Set true to always require https.
COOKIE_SECURE=
# Interactive API docs at /api/docs (loads Swagger UI from a CDN). Keep off in production.
ENABLE_API_DOCS=false
# Minutes before a login expires
ACCESS_TOKEN_MINUTES=720
# Browser origins allowed to call the API from another domain (empty when the app serves its own UI)
CORS_ORIGINS=

# ---- Database ------------------------------------------------------------------------------------------
# Leave empty in local mode (SQLite). docker-compose builds this from POSTGRES_PASSWORD.
DATABASE_URL=
POSTGRES_PASSWORD=
# Where uploaded files and the local database live
# MDOS_DATA_DIR=/data

# ---- Claude (optional; the app works offline without it) ---------------------------------------------
ANTHROPIC_API_KEY=
MDOS_LLM_MODEL=claude-opus-5-5
MDOS_LLM_EFFORT=medium
MDOS_LLM_FALLBACKS=true
MDOS_LLM_TIMEOUT_SECONDS=120

# ---- Limits ------------------------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_JSON_MB=5
MAX_ROWS=100000
MAX_COLS=500
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AGENTS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=30

# thread: agents run in the background (default); sync: run inline (tests)
EXECUTION_MODE=thread
